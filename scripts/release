#!/bin/sh
# Builds a signed, notarized Listful release DMG into dist/.
#
#   scripts/release            Developer ID signing + notarization (for distribution)
#   scripts/release --adhoc    local signature only, no notarization (for testing the packaging)
#
# Environment:
#   SIGN_IDENTITY    codesign identity; defaults to the first "Developer ID Application" in the keychain
#   NOTARY_PROFILE   notarytool keychain profile (default: listful-notary), created once with
#                    xcrun notarytool store-credentials listful-notary --apple-id <id> --team-id <team>
#   RELEASE_REPO     GitHub repo the releases are published to (default: drchrispinnock/listful);
#                    the app's update feed is that repo's latest-release appcast.xml
#
# The version comes from VERSION; the build number is the git commit count.
# CHANGELOG.md must have a "## <VERSION>" section: it becomes dist/release-notes.md
# (for the GitHub release) and the notes shown in the app's update window.
# Besides the DMG it writes dist/appcast.xml, the Sparkle update feed, signed with the
# EdDSA key in the keychain (account "listful", made by Sparkle's generate_keys). Upload
# both to the GitHub release tagged v<VERSION>.
set -eu

cd "$(dirname "$0")/.."

adhoc=false
[ "${1:-}" = "--adhoc" ] && adhoc=true

version=$(cat VERSION)
build=$(git rev-list --count HEAD 2>/dev/null || echo 1)
year=$(date +%Y)
dist=dist
app="$dist/Listful.app"
dmg="$dist/Listful-$version.dmg"
profile=${NOTARY_PROFILE:-listful-notary}
repo=${RELEASE_REPO:-drchrispinnock/listful}
feed="https://github.com/$repo/releases/latest/download/appcast.xml"
sparkle_bin=.build/artifacts/sparkle/Sparkle/bin

step() { printf '\n==> %s\n' "$*"; }

# Fail before the long build if the changelog hasn't been written.
notes=$(scripts/release-notes "$version")
notes_html=$(scripts/release-notes --html "$version")

if $adhoc; then
    identity=-
else
    identity=${SIGN_IDENTITY:-$(security find-identity -v -p codesigning |
        sed -n 's/.*"\(Developer ID Application: .*\)"/\1/p' | head -n 1)}
    if [ -z "$identity" ]; then
        echo "No \"Developer ID Application\" certificate found in the keychain." >&2
        echo "Install one (see README), set SIGN_IDENTITY, or use --adhoc." >&2
        exit 1
    fi
fi

step "Listful $version ($build), signing as: $identity"

step "Building universal release binary"
swift build -c release --arch arm64 --arch x86_64
bin=$(swift build -c release --arch arm64 --arch x86_64 --show-bin-path)

step "Assembling $app"
rm -rf "$dist"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp "$bin/Listful" "$app/Contents/MacOS/Listful"
sed -e "s/__VERSION__/$version/" -e "s/__BUILD__/$build/" -e "s/__YEAR__/$year/" \
    -e "s|__FEED_URL__|$feed|" packaging/Info.plist > "$app/Contents/Info.plist"
plutil -lint -s "$app/Contents/Info.plist"
printf 'APPL????' > "$app/Contents/PkgInfo"

# Sparkle (Check for Updates). SwiftPM links it via @rpath next to the binary;
# in the bundle it lives in Contents/Frameworks. Its XPC services are only
# needed by sandboxed apps, which Listful isn't.
fw="$app/Contents/Frameworks/Sparkle.framework"
mkdir -p "$app/Contents/Frameworks"
ditto "$bin/Sparkle.framework" "$fw"
rm -rf "$fw/XPCServices" "$fw/Versions/B/XPCServices"
install_name_tool -add_rpath @executable_path/../Frameworks "$app/Contents/MacOS/Listful"

iconset=$(mktemp -d)/AppIcon.iconset
mkdir -p "$iconset"
for size in 16 32 128 256 512; do
    sips -z $size $size spec/icon.png --out "$iconset/icon_${size}x${size}.png" > /dev/null
    sips -z $((size * 2)) $((size * 2)) spec/icon.png --out "$iconset/icon_${size}x${size}@2x.png" > /dev/null
done
iconutil -c icns "$iconset" -o "$app/Contents/Resources/AppIcon.icns"
rm -rf "$(dirname "$iconset")"

# Keep debug symbols beside the release for symbolicating crash reports.
[ -d "$bin/Listful.dSYM" ] && cp -R "$bin/Listful.dSYM" "$dist/Listful-$version.dSYM"

step "Signing app (hardened runtime)"
if $adhoc; then
    sign() { codesign --force --options runtime --sign - "$@"; }
else
    sign() { codesign --force --options runtime --timestamp --sign "$identity" "$@"; }
fi
# Inside out: Sparkle's helpers, the framework, then the app.
sign "$fw/Versions/B/Autoupdate"
sign "$fw/Versions/B/Updater.app"
sign "$fw"
sign "$app"
codesign --verify --strict --verbose=2 "$app"

step "Creating $dmg"
staging=$(mktemp -d)
cp -R "$app" "$staging/"
ln -s /Applications "$staging/Applications"
hdiutil create -volname "Listful $version" -srcfolder "$staging" -format UDZO -ov "$dmg" > /dev/null
rm -rf "$staging"

if $adhoc; then
    step "Ad-hoc build done (not notarized; Gatekeeper will block it on other Macs)"
else
    codesign --force --timestamp --sign "$identity" "$dmg"

    step "Notarizing (this usually takes a few minutes)"
    result=$(xcrun notarytool submit "$dmg" --keychain-profile "$profile" --wait 2>&1) || true
    echo "$result"
    if ! echo "$result" | grep -q "status: Accepted"; then
        id=$(echo "$result" | sed -n 's/^ *id: //p' | head -n 1)
        echo "Notarization failed. Details: xcrun notarytool log $id --keychain-profile $profile" >&2
        exit 1
    fi

    step "Stapling"
    xcrun stapler staple "$dmg"
    xcrun stapler staple "$app"

    step "Gatekeeper check"
    spctl --assess --type open --context context:primary-signature --verbose=2 "$dmg"
    spctl --assess --type execute --verbose=2 "$app"
fi

(cd "$dist" && shasum -a 256 "$(basename "$dmg")" > "$(basename "$dmg").sha256")
printf '%s\n' "$notes" > "$dist/release-notes.md"

if $adhoc; then
    step "Skipping appcast.xml: ad-hoc builds aren't published as updates"
else
    step "Writing $dist/appcast.xml (feed: $feed)"
    # Prints: sparkle:edSignature="…" length="…"
    signature=$("$sparkle_bin/sign_update" --account listful "$dmg")
    cat > "$dist/appcast.xml" <<EOF
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
  <channel>
    <title>Listful</title>
    <item>
      <title>Listful $version</title>
      <pubDate>$(LC_ALL=C date -u '+%a, %d %b %Y %H:%M:%S +0000')</pubDate>
      <sparkle:version>$build</sparkle:version>
      <sparkle:shortVersionString>$version</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
      <description><![CDATA[
$notes_html
]]></description>
      <sparkle:fullReleaseNotesLink>https://github.com/$repo/releases/tag/v$version</sparkle:fullReleaseNotesLink>
      <enclosure url="https://github.com/$repo/releases/download/v$version/$(basename "$dmg")"
                 type="application/octet-stream" $signature/>
    </item>
  </channel>
</rss>
EOF
    xmllint --noout "$dist/appcast.xml"
fi

step "Done: $dmg"
cat "$dist/$(basename "$dmg").sha256"
